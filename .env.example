# ollama | openai
LLM_PROVIDER=ollama

# Local Ollama. Pull the model first: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible provider. Used only when LLM_PROVIDER=openai.
# Do not commit the real key. Copy this file to .env and fill it in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Mock User Directory started by main.py if it is not already up.
API_BASE_URL=http://127.0.0.1:8765
# USER_DB_PATH=data/users.json

LLM_TEMPERATURE=0

# Optional. Used by docker compose when `ollama pull` cannot reach the registry.
# GGUF_FILE=C:/path/to/qwen2.5-3b-instruct-q4_k_m.gguf
